{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frob.stack-lock/1",
  "title": "FrankenRobotics Stack Lock (frob.stack-lock/1)",
  "description": "Generated from xtask::stack::lock::json_schema() (N33a-03).",
  "type": "object",
  "additionalProperties": false,
  "required": ["toolchain"],
  "properties": {
    "toolchain": { "$ref": "#/$defs/channel" },
    "foundation": { "type": "array", "items": { "$ref": "#/$defs/foundation" } },
    "freeze": { "$ref": "#/$defs/freeze" },
    "json_library": { "$ref": "#/$defs/json_library" },
    "auditor": { "$ref": "#/$defs/auditor" }
  },
  "$defs": {
    "posture": { "type": "string", "enum": ["consume", "consume-path", "subprocess", "lift", "oracle", "pattern", "build-time"] },
    "tier": { "type": "string", "enum": ["solid", "frontier", "moonshot"] },
    "milestone": { "type": "string", "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8"] },
    "channel": { "type": "string", "pattern": "^(nightly-[0-9]{4}-[0-9]{2}-[0-9]{2}|(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?)$" },
    "stable_channel": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$" },
    "fd_id": { "type": "string", "pattern": "^FD-[A-Z0-9]+$" },
    "rel_path": { "type": "string", "pattern": "^\\.\\./(?:[^./\\\\\\x00-\\x1f\\x7f]|\\.[^./\\\\\\x00-\\x1f\\x7f]|\\.\\.[^/\\\\\\x00-\\x1f\\x7f])[^/\\\\\\x00-\\x1f\\x7f]*(?:/(?:[^./\\\\\\x00-\\x1f\\x7f]|\\.[^./\\\\\\x00-\\x1f\\x7f]|\\.\\.[^/\\\\\\x00-\\x1f\\x7f])[^/\\\\\\x00-\\x1f\\x7f]*)*$" },
    "git_rev": { "type": "string", "pattern": "^([0-9a-f]{40}|unadmitted)$" },
    "exact_version": { "type": "string", "pattern": "^=(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})\\.(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})\\.(?:0|[1-9][0-9]{0,18}|18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0})(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "gate_ref": { "type": "string", "pattern": "^(none|INT-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]+(?:\\.\\.[0-9]+)?)$" },
    "blake3_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "use_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture"],
      "properties": {
        "posture": { "$ref": "#/$defs/posture" },
        "purpose": { "type": "string" },
        "confined_to": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tier": { "$ref": "#/$defs/tier" },
        "first_needed": { "$ref": "#/$defs/milestone" }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "admission_gate", "fallback"],
      "properties": {
        "id": { "$ref": "#/$defs/fd_id" },
        "name": { "type": "string", "minLength": 1 },
        "posture": { "$ref": "#/$defs/posture" },
        "uses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/use_entry" } },
        "path": { "$ref": "#/$defs/rel_path" },
        "git_rev": { "$ref": "#/$defs/git_rev" },
        "version": { "$ref": "#/$defs/exact_version" },
        "toolchain": { "$ref": "#/$defs/channel" },
        "features": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "build_env": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string", "pattern": "^[\\u0020-\\u007e]*$" }
        },
        "confined_to": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "admission_gate": { "$ref": "#/$defs/gate_ref" },
        "receipt": { "$ref": "#/$defs/blake3_hex" },
        "fallback": { "type": "string", "minLength": 1 },
        "first_needed": { "$ref": "#/$defs/milestone" },
        "critical_path": { "type": "boolean" },
        "note": { "type": "string" },
        "required_at": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
        "optional_at": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
        "firewall_cells": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/milestone" },
          "additionalProperties": { "type": "string" }
        }
      },
      "oneOf": [
        { "required": ["posture"], "not": { "required": ["uses"] } },
        { "required": ["uses"], "not": { "anyOf": [{ "required": ["posture"] }, { "required": ["confined_to"] }] } }
      ],
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "FD-FSIM" } }, "required": ["id"] },
          "then": { "properties": { "features": { "type": "array", "items": { "type": "string", "enum": ["referee", "geometry", "ledger", "optimize", "stats", "spectral", "actuation", "structure", "multiphysics"] } } } }
        },
        {
          "if": { "anyOf": [
            { "required": ["posture"], "properties": { "posture": { "enum": ["consume-path", "build-time"] } } },
            { "required": ["uses"], "properties": { "uses": { "contains": { "required": ["posture"], "properties": { "posture": { "enum": ["consume-path", "build-time"] } } } } } }
          ] },
          "then": { "required": ["path"] }
        },
        {
          "if": { "anyOf": [
            { "required": ["posture"], "properties": { "posture": { "const": "consume" } } },
            { "required": ["uses"], "properties": { "uses": { "contains": { "required": ["posture"], "properties": { "posture": { "const": "consume" } } } } } }
          ] },
          "then": { "required": ["version"] }
        }
      ]
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable"],
      "properties": { "stable": { "$ref": "#/$defs/stable_channel" } }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign", "receipt", "opened", "closed", "reason"],
      "properties": {
        "campaign": { "type": "string", "minLength": 1 },
        "receipt": { "$ref": "#/$defs/blake3_hex" },
        "opened": { "type": "string", "minLength": 1 },
        "closed": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "json_library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "allowed_in", "features"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "allowed_in": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "features": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
