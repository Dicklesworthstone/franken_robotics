{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankenrobotics.local/schemas/registries/capsules.schema.json",
  "title": "FrankenRobotics Unsafe-Capsule Registry (frob.capsules/1)",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "frob.capsules/1"
    },
    "capsule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "workspace",
          "path",
          "safe_api",
          "lines",
          "unsafe_blocks",
          "safety_doc",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "workspace": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "safe_api": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 299
          },
          "unsafe_blocks": {
            "type": "integer",
            "minimum": 1
          },
          "safety_doc": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
