{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankenrobotics.local/schemas/registries/formats.schema.json",
  "title": "FrankenRobotics Artifact Format Registry (frob.formats/1)",
  "type": "object",
  "required": ["schema", "format"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "frob.formats/1"
    },
    "format": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "extension",
          "schema",
          "owner",
          "producers",
          "consumers",
          "encoding"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FMT-[A-Z0-9-]+$"
          },
          "extension": {
            "type": "string",
            "pattern": "^\\.[a-z][a-z0-9]*$"
          },
          "schema": {
            "type": "string",
            "pattern": "^frob\\.[a-z0-9.]+/[0-9]+$"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "producers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "encoding": {
            "type": "string",
            "enum": ["canonical", "view"]
          },
          "kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
