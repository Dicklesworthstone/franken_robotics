{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankenrobotics.local/schemas/registries/gates.schema.json",
  "title": "FrankenRobotics Gate Registry (frob.gates/1)",
  "description": "Base gate record schema shipped at BD-002 (owned by N38b-18 and extended additively by N40-01). Status is recorded per [[gate.part]] and derived for each gate.",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "frob.gates/1"
    },
    "gate": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate_row"
      }
    }
  },
  "$defs": {
    "milestone": {
      "type": "string",
      "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8"]
    },
    "claim_kind": {
      "type": "string",
      "enum": [
        "proof",
        "known-answer",
        "parity",
        "fidelity",
        "design-comparison",
        "reality",
        "performance"
      ]
    },
    "part_status": {
      "type": "string",
      "enum": [
        "not-run",
        "pass",
        "fail",
        "killed",
        "blocked",
        "no-claim",
        "superseded"
      ]
    },
    "recorded": {
      "type": "object",
      "required": ["date", "session", "implemented_by"],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string"
        },
        "session": {
          "type": "string"
        },
        "implemented_by": {
          "type": "string",
          "description": "Sorted, comma-joined session identifiers of all implementers."
        }
      }
    },
    "gate_part": {
      "type": "object",
      "required": ["milestone", "status", "measured", "evidence", "recorded"],
      "additionalProperties": false,
      "properties": {
        "milestone": {
          "$ref": "#/$defs/milestone"
        },
        "status": {
          "$ref": "#/$defs/part_status"
        },
        "measured": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recorded": {
          "$ref": "#/$defs/recorded"
        },
        "kill_gate": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "open_question": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pass" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "measured": { "minLength": 1 },
              "recorded": {
                "properties": {
                  "session": { "minLength": 1 }
                },
                "required": ["session"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "killed" } },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["kill_gate", "fallback"],
                "properties": {
                  "kill_gate": { "minLength": 1 },
                  "fallback": { "minLength": 1 }
                }
              },
              {
                "required": ["detail"],
                "properties": {
                  "detail": { "minLength": 1 }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "blocked" } },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              {
                "required": ["open_question"],
                "properties": {
                  "open_question": { "minLength": 1 }
                }
              },
              {
                "required": ["detail"],
                "properties": {
                  "detail": { "minLength": 1 }
                }
              }
            ]
          }
        }
      ]
    },
    "gate_row": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "claim_id",
        "section",
        "threshold",
        "milestone",
        "tier",
        "controls"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "$ref": "#/$defs/claim_kind"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "type": "string",
          "minLength": 1
        },
        "milestone": {
          "$ref": "#/$defs/milestone"
        },
        "tier": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "part": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate_part"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "part": {
                "contains": {
                  "properties": { "status": { "const": "pass" } },
                  "required": ["status"]
                }
              }
            },
            "required": ["part"]
          },
          "then": {
            "properties": {
              "controls": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "part": {
                "contains": {
                  "properties": { "status": { "const": "no-claim" } },
                  "required": ["status"]
                }
              }
            },
            "required": ["part"]
          },
          "then": {
            "properties": {
              "claim": { "const": "reality" }
            }
          }
        }
      ]
    }
  }
}
