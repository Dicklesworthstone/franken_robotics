{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankenrobotics.local/schemas/registries/refusals.schema.json",
  "title": "FrankenRobotics Refusal Registry (frob.refusals/1)",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "frob.refusals/1"
    },
    "exit_rule": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FROB-REF-[1-9][0-9]{2,3}$"
            }
          }
        ]
      }
    },
    "refusal": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "meaning", "defined_in", "exit", "retry", "repairs", "raised_by"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^FROB-REF-[1-9][0-9]{2,3}$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "defined_in": {
            "type": "string",
            "minLength": 1
          },
          "exit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "retry": {
            "type": "string",
            "enum": ["never", "after-change", "backoff", "after-backoff", "same-key", "with-budget"]
          },
          "repairs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "raised_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FROB-REF-[1-9][0-9]{2,3}$"
            }
          }
        }
      }
    },
    "detail": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "detail", "interim", "exit", "retry", "pointer", "observed", "repairs", "raised_by", "ledger"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 },
          "interim": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^FROB-REF-[1-9][0-9]{2,3}$" }
          },
          "exit": { "type": "integer", "minimum": 1, "maximum": 255 },
          "retry": { "type": "string", "enum": ["never", "after-change", "backoff", "after-backoff", "same-key", "with-budget"] },
          "pointer": { "type": "string", "minLength": 1 },
          "observed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "repairs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "raised_by": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "ledger": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
