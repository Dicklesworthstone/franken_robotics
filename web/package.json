{
  "name": "frankenrobotics-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun src/build.ts && pagefind --site out --quiet && bun src/check.ts",
    "dev": "bun run build && wrangler dev",
    "smoke": "bun src/smoke.ts",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "pagefind": "1.6.0",
    "playwright-core": "1.65.1",
    "wrangler": "4.166.0"
  }
}
